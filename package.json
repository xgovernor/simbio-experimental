{
  "name": "@simbio/web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "commit": "commit",
    "dev": "next dev --turbopack",
    "build": "next build && rm -rf ./.next/cache",
    "start": "next start",
    "lint": "next lint --no-cache",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "commitlint": "commitlint --edit",
    "test": "vitest --config ./vitest.config.ts",
    "version": "lerna version --force-publish -y --no-push --no-changelog --no-git-tag-version $npm_package_version",
    "version:auto": "yarn version --no-git-tag-version --new-version $1",
    "changelog": "node scripts/create-changelog"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.61.6",
    "@fluentui/react-icons": "^2.0.294",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-toast": "^1.2.7",
    "@reduxjs/toolkit": "^2.6.1",
    "@tanstack/react-table": "^8.21.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^0.2.1",
    "date-fns": "^2.30.0",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "fluentui-next-appdir-directive": "^0.2.0",
    "formik": "^2.4.6",
    "framer-motion": "^11.18.2",
    "lucide": "^0.482.0",
    "lucide-react": "^0.298.0",
    "motion": "^12.6.3",
    "nanoid": "^5.1.5",
    "next": "15.2.2",
    "next-auth": "5.0.0-beta.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "satori": "^0.10.14",
    "swr": "^2.3.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^18.6.3",
    "@commitlint/prompt-cli": "^18.6.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@next/bundle-analyzer": "15.2.2",
    "@tailwindcss/postcss": "^4.1.3",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^20.17.30",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/redux-logger": "3.0.9",
    "@types/semver": "^7.7.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "commitlint": "^18.6.1",
    "eslint": "^9.24.0",
    "eslint-config-next": "15.2.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-unused-imports": "^3.2.0",
    "husky": "^8.0.3",
    "jsdom": "^23.2.0",
    "lerna": "^8.2.1",
    "lint-staged": "^15.5.0",
    "postcss": "^8.5.3",
    "postcss-prefixer": "^3.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react-scan": "^0.2.14",
    "redux-logger": "3.0.6",
    "semver": "^7.7.1",
    "standard-changelog": "^5.0.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.1"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix",
      "eslint"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "browser": {
    "crypto": false
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "esbuild",
      "nx",
      "sharp"
    ],
    "overrides": {
      "@types/react": "19.0.10",
      "@types/react-dom": "19.0.4"
    }
  }
}
